  "dependencies": {
    "@yukinu/lib": "workspace:*",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@yukinu/tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
