{
  "name": "@yukinu/api",
  "version": "0.10.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./*": {
      "types": "./dist/modules/*/types.d.mts",
      "default": "./dist/modules/*/types.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "~dev": "tsdown --watch ./src"
  },
  "dependencies": {
    "@trpc/client": "catalog:trpc",
    "@trpc/server": "catalog:trpc",
    "@yukinu/auth": "workspace:*",
    "@yukinu/db": "workspace:*",
    "@yukinu/email": "workspace:*",
    "@yukinu/lib": "workspace:*",
    "@yukinu/uploadthing": "workspace:*",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@yukinu/oxc": "workspace:*",
    "@yukinu/tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
