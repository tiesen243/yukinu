{
  "name": "@yukinu/lib",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "~dev": "tsdown --watch"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:prod",
    "superjson": "catalog:trpc",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@yukinu/tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "exports": {
    "./constants": {
      "types": "./dist/constants.d.mts",
      "default": "./dist/constants.mjs"
    },
    "./create-env": {
      "types": "./dist/create-env.d.mts",
      "default": "./dist/create-env.mjs"
    },
    "./create-id": {
      "types": "./dist/create-id.d.mts",
      "default": "./dist/create-id.mjs"
    },
    "./create-query-client": {
      "types": "./dist/create-query-client.d.mts",
      "default": "./dist/create-query-client.mjs"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.mts",
      "default": "./dist/rate-limit.mjs"
    },
    "./slugify": {
      "types": "./dist/slugify.d.mts",
      "default": "./dist/slugify.mjs"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.mts",
      "default": "./dist/standard-schema.mjs"
    },
    "./standard-schema.d.ts": {
      "types": "./dist/standard-schema.d.ts.d.mts",
      "default": "./dist/standard-schema.d.ts.mjs"
    },
    "./package.json": "./package.json"
  }
}
