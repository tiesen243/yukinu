{
  "name": "@yukinu/lib",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "~dev": "tsdown --watch"
  },
  "devDependencies": {
    "@yukinu/oxc": "workspace:*",
    "@yukinu/tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "zod": "catalog:prod"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:prod"
  }
}
