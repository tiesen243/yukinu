{
  "name": "@yukinu/uploadthing",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "~dev": "tsdown --watch ./src"
  },
  "dependencies": {
    "@uploadthing/react": "catalog:uploadthing",
    "@yukinu/auth": "workspace:*",
    "uploadthing": "catalog:uploadthing"
  },
  "devDependencies": {
    "@yukinu/oxc": "workspace:*",
    "@yukinu/tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@uploadthing/shared": "^7.1.10"
  }
}
