{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputLogs": "new-only"
    }
  },
  "globalEnv": [
    "VITE_APP_NAME",
    "NEXT_PUBLIC_APP_NAME",

    "VITE_WEB_URL",
    "NEXT_PUBLIC_WEB_URL",

    "VITE_DASHBOARD_URL",
    "NEXT_PUBLIC_DASHBOARD_URL",

    "DATABASE_URL",

    "AUTH_SECRET",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",

    "RESEND_TOKEN",
    "UPLOADTHING_TOKEN",

    "TURNSTILE_SECRET_KEY",
    "VITE_TURNSTILE_SITE_KEY",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",

    "PORT"
  ],
  "globalPassThroughEnv": [
    "CI",
    "MODE",
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",

    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",

    "npm_lifecycle_event"
  ]
}
