{
  "name": "yukinu",
  "private": true,
  "homepage": "https://yukinu.vercel.app",
  "bugs": {
    "url": "https://github.com/tiesen243/yukinu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiesen243/yukinu.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter './packages/*'",
    "changeset": "changeset",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "dev": "turbo dev --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.9.12"
  },
  "packageManager": "bun@1.3.0",
  "catalogs": {
    "prod": {
      "@tanstack/react-query": "^5.100.10",
      "nuqs": "^2.8.9",
      "recharts": "^3.8.1",
      "zod": "^4.4.3"
    },
    "dev": {
      "tsdown": "^0.22.0",
      "typescript": "^6.0.3"
    },
    "react": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "react": "19.2.6",
      "react-dom": "19.2.6"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.3.0",
      "@tailwindcss/vite": "^4.3.0",
      "tailwindcss": "^4.3.0"
    },
    "uploadthing": {
      "@uploadthing/react": "^7.3.3",
      "uploadthing": "^7.7.4"
    },
    "trpc": {
      "@trpc/server": "^11.17.0",
      "@trpc/client": "^11.17.0",
      "@trpc/tanstack-react-query": "^11.17.0",
      "superjson": "^2.2.2"
    }
  }
}
